# ─────────────────────────────────────────────────────────────────────────────
# Inkwell configuration. Copy to .env.local and fill in what you need.
# Every variable is optional: with nothing set, Inkwell runs with local checks
# only (spelling, grammar and style in the browser) and AI features show a calm
# "not configured" state.
#
# All of these are SERVER-ONLY. None use the NEXT_PUBLIC_ prefix, and none are
# ever sent to the browser (`pnpm check:bundle` verifies this).
# ─────────────────────────────────────────────────────────────────────────────

# Which AI provider the server uses:
#   anthropic          Claude via the Anthropic API (default). Needs ANTHROPIC_API_KEY.
#   openai             OpenAI. Needs OPENAI_API_KEY.
#   openai-compatible  Any OpenAI-compatible endpoint: Ollama, LM Studio, OpenRouter, Groq…
#                      Needs INKWELL_AI_BASE_URL and INKWELL_AI_FAST_MODEL.
#   mock               Deterministic fake model for tests and offline development (labeled "Mock" in the UI).
#   none               AI off; local checks only.
INKWELL_AI_PROVIDER=anthropic

# Model for real-time corrections. Use a small, fast model.
# Defaults: anthropic → claude-haiku-4-5-20251001, openai → gpt-5-mini
INKWELL_AI_FAST_MODEL=

# Model for writing actions (improve, shorten, tone, continue, summarize…).
# Defaults: anthropic → claude-sonnet-5, openai → gpt-5 (openai-compatible → the fast model)
INKWELL_AI_QUALITY_MODEL=

# Base URL for openai-compatible providers (and optionally a proxy for anthropic/openai), e.g.
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
INKWELL_AI_BASE_URL=

# API keys (server-side only).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Key for an openai-compatible endpoint (falls back to OPENAI_API_KEY; many local servers need none).
INKWELL_AI_API_KEY=

# Timeout for one real-time check, in milliseconds (includes retries). Default 8000.
INKWELL_AI_TIMEOUT_MS=8000
# Timeout for a writing action, in milliseconds. Default 60000.
INKWELL_AI_WRITE_TIMEOUT_MS=60000

# Per-client rate limit on /api/ai/check, requests per minute (writing actions get 1/6 of this). Default 120.
INKWELL_RATE_LIMIT_PER_MIN=120

# Mock provider only: artificial latency (ms) and default failure mode
# (ok | error | timeout | malformed | ratelimit | flaky | noisy | empty). Defaults 250 / ok.
INKWELL_MOCK_LATENCY_MS=250
INKWELL_MOCK_MODE=ok

# Set to "silent" to suppress the server's metadata-only AI logs (used by unit tests).
INKWELL_LOG=
